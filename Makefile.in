.POSIX:
.SUFFIXES:
.SUFFIXES: .cpp .uto .coverage

CXX        = @CXX@
CCOV       = gcov
CFLAGS     = @CFLAGS@
CFLAGS_COV = @CFLAGS_COV@
CFLAGS_SAN = @CFLAGS_SAN@

.PHONY: all
all: fcmp.coverage rollingmean.coverage

fcmp.coverage: tests/fcmp.cpp tests/test_fcmp.cpp

rollingmean.coverage: rollingmean.cpp tests/test_rollingmean.cpp tests/fcmp.cpp

.c.uto:
	$(CXX) $(CFLAGS) $(CFLAGS_COV) $(CFLAGS_SAN) -I. -c $< -o $@

.cpp.coverage:
	$(CXX) $(CFLAGS) $(CFLAGS_COV) $(CFLAGS_SAN) -I. -c $< -o $$(basename $< .cpp).uto
	$(CXX) $(CFLAGS) $(CFLAGS_COV) $(CFLAGS_SAN) -I. $$(echo $^ | sed -E -e 's/(^| )$</'$$(basename $< .cpp).uto'/g') -o $@
	./$@
	$(CCOV) $<
	! grep "#####" $<.gcov

.PHONY: clean
clean:
	rm -f *.o **/*.o *.uto **/*.uto *.gc?? **/*.gc?? *.coverage

.PHONY: distclean
distclean: clean
	rm -f Makefile config.status
